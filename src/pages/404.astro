---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="container page">
    <h1>Page not found</h1>
    <p class="weak">This link may be out of date.</p>
    <a href="/">Go to the home page</a>
  </div>
</Base>

<style>
  .page { padding-block: var(--xxl); display: flex; flex-direction: column; align-items: flex-start; gap: var(--m); }
  a { display: inline-flex; align-items: center; min-height: var(--target); }
  h1 { font-size: clamp(37px, 4.2vw, 54px); line-height: 1.18; letter-spacing: -0.025em; }
</style>
